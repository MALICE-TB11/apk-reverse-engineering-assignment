        <LinearLayout android:orientation="vertical" android:id="@id/splashLayout" android:layout_width="match_parent" android:layout_height="match_parent" />
        <RelativeLayout android:id="@id/splashbg" android:layout_width="match_parent" android:layout_height="match_parent">
            <ImageView android:id="@id/app_logo" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" />
