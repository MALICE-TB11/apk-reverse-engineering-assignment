<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/button_secondary_end" android:endColor="@color/button_secondary_start" android:angle="90.0" />
            <corners android:radius="12.0dp" />
            <stroke android:width="1.0dp" android:color="@color/button_secondary_end" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_disabled_background" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/button_secondary_start" android:endColor="@color/button_secondary_end" android:angle="90.0" />
            <corners android:radius="12.0dp" />
            <stroke android:width="1.0dp" android:color="@color/button_secondary_end" />
        </shape>
    </item>
</selector>
