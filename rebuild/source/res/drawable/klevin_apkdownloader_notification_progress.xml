<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill_horizontal|center" android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/klevin_apkdownloader_notification_download_progress_background_color" />
            <corners android:radius="100.0dp" />
        </shape>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <solid android:color="@color/klevin_apkdownloader_notification_download_progress_color" />
                <corners android:radius="100.0dp" />
            </shape>
        </scale>
    </item>
</layer-list>
