*.apk filter=lfs diff=lfs merge=lfs -text
sample.apk filter=lfs diff=lfs merge=lfs -text

# Keep textual evidence and scripts byte-stable on Windows checkouts.
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.smali text eol=lf
*.asm text eol=lf
*.java text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Preserve whitespace inside the original decoded multiline string literal.
rebuild/source/res/values/strings.xml whitespace=-blank-at-eol
